#version 450
#extension GL_GOOGLE_include_directive : require

// Resolves collisions between neighboring particles and moves them forward in time.
// Reads the sorted particles (B) and writes the new state (A).

#include "particle.glsl"
#include "interaction.glsl"
#include "random.glsl"
#include "solid.glsl"
#include "boundary.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= sim.particle_count)
    {
        return;
    }

    bool flowing = (sim.flow_speed > 0.0F);

    Particle self   = particles_b[index];
    ivec2    coords = cell_coords(self.position);

    vec2 acceleration = vec2(0.0F);

    ivec2 lower_cell = max(coords - ivec2(1), ivec2(0));
    ivec2 upper_cell = min(coords + ivec2(1), sim.grid_size - ivec2(1));

    for (int y = lower_cell.y; y <= upper_cell.y; ++y)
    {
        // Cells in a row are contiguous in the sorted buffer so
        // the whole row can be processed as a single range.
        uint first_cell = cell_index(ivec2(lower_cell.x, y));
        uint last_cell  = cell_index(ivec2(upper_cell.x, y));

        uint first = (first_cell == 0U) ? 0U : grid[first_cell - 1U];
        uint last  = grid[last_cell];

        for (uint other = first; other < last; ++other)
        {
            if (other != index)
            {
                interact(acceleration, self, particles_b[other]);
            }
        }

        // When flowing, the left and right sides of the tunnel are connected so
        // particles in the first and last columns also touch each other.
        if (flowing && (coords.x == 0 || coords.x == sim.grid_size.x - 1))
        {
            int   wrapped_x = (coords.x == 0) ? sim.grid_size.x - 1 : 0;
            float shift     = (coords.x == 0) ? -sim.tunnel_size.x : sim.tunnel_size.x;

            uint wrapped_cell = cell_index(ivec2(wrapped_x, y));

            first = (wrapped_cell == 0U) ? 0U : grid[wrapped_cell - 1U];
            last  = grid[wrapped_cell];

            for (uint other = first; other < last; ++other)
            {
                Particle neighbor = particles_b[other];
                neighbor.position.x += shift;
                interact(acceleration, self, neighbor);
            }
        }
    }

    // Semi-implicit Euler: the new velocity is used to update the position.
    vec2 velocity = self.velocity + (acceleration * sim.delta_time);
    vec2 position = self.position + (velocity * sim.delta_time);

    apply_boundaries(index, position, velocity);

    particles_a[index].position = position;
    particles_a[index].velocity = velocity;
}
