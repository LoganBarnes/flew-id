#version 450
#extension GL_GOOGLE_include_directive : require

// Resolves collisions between neighboring particles and moves them forward in time.
// Reads the sorted particles (B) and writes the new state (A).

#include "particle.glsl"
#include "interaction.glsl"
#include "random.glsl"
#include "solid.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= sim.particle_count)
    {
        return;
    }

    bool flowing = (sim.flow_speed > 0.0F);

    Particle self   = particles_b[index];
    ivec2    coords = cell_coords(self.position);

    vec2 acceleration = vec2(0.0F);

    ivec2 lower_cell = max(coords - ivec2(1), ivec2(0));
    ivec2 upper_cell = min(coords + ivec2(1), sim.grid_size - ivec2(1));

    for (int y = lower_cell.y; y <= upper_cell.y; ++y)
    {
        // Cells in a row are contiguous in the sorted buffer so
        // the whole row can be processed as a single range.
        uint first_cell = cell_index(ivec2(lower_cell.x, y));
        uint last_cell  = cell_index(ivec2(upper_cell.x, y));

        uint first = (first_cell == 0U) ? 0U : grid[first_cell - 1U];
        uint last  = grid[last_cell];

        for (uint other = first; other < last; ++other)
        {
            if (other != index)
            {
                interact(acceleration, self, particles_b[other]);
            }
        }

        // When flowing, the left and right sides of the tunnel are connected so
        // particles in the first and last columns also touch each other.
        if (flowing && (coords.x == 0 || coords.x == sim.grid_size.x - 1))
        {
            int   wrapped_x = (coords.x == 0) ? sim.grid_size.x - 1 : 0;
            float shift     = (coords.x == 0) ? -sim.tunnel_size.x : sim.tunnel_size.x;

            uint wrapped_cell = cell_index(ivec2(wrapped_x, y));

            first = (wrapped_cell == 0U) ? 0U : grid[wrapped_cell - 1U];
            last  = grid[wrapped_cell];

            for (uint other = first; other < last; ++other)
            {
                Particle neighbor = particles_b[other];
                neighbor.position.x += shift;
                interact(acceleration, self, neighbor);
            }
        }
    }

    // Semi-implicit Euler: the new velocity is used to update the position.
    vec2 velocity = self.velocity + (acceleration * sim.delta_time);
    vec2 position = self.position + (velocity * sim.delta_time);

    vec2 lower = vec2(sim.radius);
    vec2 upper = sim.tunnel_size - vec2(sim.radius);

    if (flowing)
    {
        // Particles leaving one side of the tunnel enter the other.
        position.x = mod(position.x, sim.tunnel_size.x);

        // Randomly reset particles in the inflow region to the incoming flow
        // conditions. This drives the flow, removes the wake of the solids before
        // it re-enters the tunnel, and keeps the temperature of the fluid constant.
        if (position.x < sim.inflow_width)
        {
            uint seed = pcg_hash(index ^ pcg_hash(sim.step_index));

            if (random_float(seed) < (sim.inflow_rate * sim.delta_time))
            {
                velocity = vec2(sim.flow_speed, 0.0F)
                         + (random_normal(seed) * sim.thermal_speed * 0.70710678F);
            }
        }
    }
    else
    {
        // Reflect off the ends of the tunnel.
        if (position.x < lower.x) { position.x = (2.0F * lower.x) - position.x; velocity.x = abs(velocity.x); }
        if (position.x > upper.x) { position.x = (2.0F * upper.x) - position.x; velocity.x = -abs(velocity.x); }
        position.x = clamp(position.x, lower.x, upper.x);
    }

    // Reflect off the top and bottom of the tunnel.
    if (position.y < lower.y) { position.y = (2.0F * lower.y) - position.y; velocity.y = abs(velocity.y); }
    if (position.y > upper.y) { position.y = (2.0F * upper.y) - position.y; velocity.y = -abs(velocity.y); }
    position.y = clamp(position.y, lower.y, upper.y);

    // Collide with the solids.
    vec4  solid    = sample_solids(position, sim.tunnel_size, sim.solid_size);
    float distance = solid.x;

    if (distance < sim.radius)
    {
        vec2 normal = normalize(solid.yz + vec2(0.0F, 1.0e-12F));

        // Move back to the surface.
        position += (sim.radius - distance) * normal;

        float normal_speed     = dot(velocity, normal);
        vec2  tangent_velocity = velocity - (normal_speed * normal);

        if (normal_speed < 0.0F)
        {
            normal_speed = -sim.wall_restitution * normal_speed;
        }
        velocity = (normal_speed * normal) + ((1.0F - sim.wall_friction) * tangent_velocity);
    }

    particles_a[index].position = position;
    particles_a[index].velocity = velocity;
}
