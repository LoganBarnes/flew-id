#version 450
#extension GL_GOOGLE_include_directive : require

// SPH, first pass: the density of the fluid at each particle. Reads the sorted
// particles (B) and writes one density per particle (in the same order).

#include "particle.glsl"
#include "solid.glsl"
#include "sph.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= sim.particle_count)
    {
        return;
    }

    bool flowing = (sim.flow_speed > 0.0F);

    Particle self = particles_b[index];

    // Every particle contributes to its own density.
    float kernel_sum = kernel(0.0F);

#define NEIGHBOR(other, shift)                                                   \
    {                                                                            \
        vec2 offset = self.position - particles_b[other].position;               \
        offset.x   -= shift;                                                     \
        kernel_sum += kernel(length(offset));                                    \
    }

    ivec2 coords     = cell_coords(self.position);
    ivec2 lower_cell = max(coords - ivec2(1), ivec2(0));
    ivec2 upper_cell = min(coords + ivec2(1), sim.grid_size - ivec2(1));

    for (int y = lower_cell.y; y <= upper_cell.y; ++y)
    {
        // Cells in a row are contiguous in the sorted buffer so
        // the whole row can be processed as a single range.
        uint first_cell = cell_index(ivec2(lower_cell.x, y));
        uint last_cell  = cell_index(ivec2(upper_cell.x, y));

        uint first = (first_cell == 0U) ? 0U : grid[first_cell - 1U];
        uint last  = grid[last_cell];

        for (uint other = first; other < last; ++other)
        {
            if (other != index)
            {
                NEIGHBOR(other, 0.0F);
            }
        }

        // When flowing, the left and right ends of the tunnel are connected so
        // particles in the first and last columns are also neighbors.
        if (flowing && (coords.x == 0 || coords.x == sim.grid_size.x - 1))
        {
            int   wrapped_x = (coords.x == 0) ? sim.grid_size.x - 1 : 0;
            float shift     = (coords.x == 0) ? -sim.tunnel_size.x : sim.tunnel_size.x;

            uint wrapped_cell = cell_index(ivec2(wrapped_x, y));

            first = (wrapped_cell == 0U) ? 0U : grid[wrapped_cell - 1U];
            last  = grid[wrapped_cell];

            for (uint other = first; other < last; ++other)
            {
                NEIGHBOR(other, shift);
            }
        }
    }

    float density = sim.particle_mass * kernel_sum;

    // Walls count as fluid. Without this the density (and so the pressure) would
    // drop next to a wall and the fluid would be sucked against it.
    float solid_distance = sample_solids(self.position, sim.tunnel_size, sim.solid_size).x;

    density += AVERAGE_DENSITY * wall_fraction(solid_distance);
    density += AVERAGE_DENSITY * wall_fraction(self.position.y);
    density += AVERAGE_DENSITY * wall_fraction(sim.tunnel_size.y - self.position.y);

    if (!flowing)
    {
        density += AVERAGE_DENSITY * wall_fraction(self.position.x);
        density += AVERAGE_DENSITY * wall_fraction(sim.tunnel_size.x - self.position.x);
    }

    densities[index] = density;
}
