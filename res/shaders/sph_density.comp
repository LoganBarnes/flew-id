#version 450
#extension GL_GOOGLE_include_directive : require

// SPH, first pass: the density of the fluid at each particle. Reads the sorted
// particles (B) and writes one density per particle (in the same order).

#include "particle.glsl"
#include "solid.glsl"
#include "sph.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= sim.particle_count)
    {
        return;
    }

    bool flowing = (sim.flow_speed > 0.0F);

    Particle self = particles_b[index];

    float support_sq = 4.0F * sim.smoothing_length * sim.smoothing_length;

    // Every particle contributes to its own density.
    float kernel_sum = kernel_shape(0.0F);

#define NEIGHBOR(other, shift)                                                   \
    {                                                                            \
        vec2 offset = self.position - particles_b[other].position;               \
        offset.x   -= shift;                                                     \
        float dist_sq = dot(offset, offset);                                     \
        if (dist_sq < support_sq)                                                \
        {                                                                        \
            kernel_sum += kernel_shape(dist_sq);                                 \
        }                                                                        \
    }

    ivec2 coords     = cell_coords(self.position);
    int   lower_y    = max(coords.y - SPH_CELL_REACH, 0);
    int   upper_y    = min(coords.y + SPH_CELL_REACH, sim.grid_size.y - 1);

    for (int y = lower_y; y <= upper_y; ++y)
    {
        FOR_EACH_NEIGHBOR_IN_ROW(coords, y, index, flowing, NEIGHBOR);
    }

    float density = sim.particle_mass * kernel_scale() * kernel_sum;

    // Walls count as fluid. Without this the density (and so the pressure) would
    // drop next to a wall and the fluid would be sucked against it.
    float solid_distance = sample_solids(self.position, sim.tunnel_size, sim.solid_size).x;

    density += AVERAGE_DENSITY * wall_fraction(solid_distance);
    density += AVERAGE_DENSITY * wall_fraction(self.position.y);
    density += AVERAGE_DENSITY * wall_fraction(sim.tunnel_size.y - self.position.y);

    if (!flowing)
    {
        density += AVERAGE_DENSITY * wall_fraction(self.position.x);
        density += AVERAGE_DENSITY * wall_fraction(sim.tunnel_size.x - self.position.x);
    }

    densities[index] = density;
}
